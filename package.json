{
  "name": "bien-vendre-florist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "build": "vite build --config web/vite.config.js",
    "web:dev": "vite --config web/vite.config.js --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write server web/src tests scripts/*.js *.json *.js .github/workflows/ci.yml",
    "format:check": "prettier --check server web/src tests scripts/*.js *.json *.js .github/workflows/ci.yml"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.16.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.9",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
