# Mode Database:
# Gunakan 'pglite' untuk menjalankan langsung dengan Node.js lokal (tanpa Docker):
DB_DRIVER=pglite
DB_DIRECTORY=.local/database
# Local account recovery writes private messages to .local/mail.
MAIL_MODE=local

# Atau gunakan 'postgres' jika menggunakan Docker / server PostgreSQL:
# DB_DRIVER=postgres
# POSTGRES_PASSWORD=florist_secret_2026
# DATABASE_URL=postgresql://florist:florist_secret_2026@localhost:5432/bien_vendre

WEB_PORT=3000
PORT=3000
SEED_DEMO=true
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
STORE_WHATSAPP=
STORE_INSTAGRAM=
STORE_ADDRESS=Pekanbaru, Riau
COOKIE_SECURE=false

# Optional future online email: explicitly set MAIL_MODE=resend and a verified sender.
PUBLIC_URL=http://localhost:3000
RESEND_API_KEY=
MAIL_FROM=
# Render proxy only; leave unset for direct local requests.
TRUST_PROXY=
